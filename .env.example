# Copy this file to .env.local. Keep real keys out of Git.

# [CONNECTED] Seoul real-time population and Seoul city data
SEOUL_OPEN_DATA_KEY=sample

# [NEXT] KMA ultra-short/short-range weather forecasts
KMA_SERVICE_KEY=

# [NEXT] Kakao place search, geocoding, walking/public-transit routes
KAKAO_REST_API_KEY=

# [OPTIONAL] Korea Tourism Organization TourAPI
TOUR_API_SERVICE_KEY=

# [OPTIONAL] AirKorea nationwide air quality
AIRKOREA_SERVICE_KEY=

# [OPTIONAL] Direct real-time subway arrival API
SEOUL_SUBWAY_API_KEY=

# [OPTIONAL] Direct Seoul bus arrival API
SEOUL_BUS_SERVICE_KEY=
