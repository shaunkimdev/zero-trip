# 이 파일을 프로젝트 루트의 .env.local로 복사한 뒤 필요한 값을 입력하세요.
# 실제 API 키와 비밀값은 .env.example이나 Git 저장소에 커밋하지 마세요.
# 값을 변경한 뒤에는 개발 서버 또는 운영 API 서버를 다시 시작해야 합니다.

# ─────────────────────────────────────────────────────────────────────────────
# 프런트엔드 공개 설정
# VITE_ 접두사 변수는 브라우저 번들에 공개되므로 비밀키를 입력하면 안 됩니다.
# ─────────────────────────────────────────────────────────────────────────────

# 추천 API 사용 방식입니다.
# required: 추천 API가 없거나 실패하면 오류를 표시합니다. 실제 운영 권장값입니다.
# optional: API가 없는 정적 배포에서 명확히 표시된 데모 데이터 사용을 허용합니다.
VITE_ZERO_TRIP_API_MODE=required

# 프런트엔드가 요청할 ZERO TRIP API의 공개 기준 경로입니다.
# 같은 도메인에서 /api/*를 서버로 전달한다면 기본값 /를 유지하세요.
# API가 별도 도메인에 있다면 예: https://api.example.com/
VITE_ZERO_TRIP_API_BASE_URL=/

# ─────────────────────────────────────────────────────────────────────────────
# 서울시·관광·환경 API
# ─────────────────────────────────────────────────────────────────────────────

# [현재 연동] 서울 열린데이터광장의 실시간 인구 및 서울 도시데이터 인증키입니다.
# sample은 서울시가 허용한 제한된 샘플 데이터만 조회합니다.
# 전체 데이터를 사용하려면 발급받은 실제 인증키로 교체하세요.
SEOUL_OPEN_DATA_KEY=sample

# [추후 연동용] 기상청 초단기·단기예보 서비스키입니다.
# 현재 추천 엔진에는 연결되지 않았으므로 날씨 기능을 추가할 때 입력하세요.
KMA_SERVICE_KEY=

# [추후 연동용] 카카오 장소 검색, 주소↔좌표 변환 및 경로 기능용 REST API 키입니다.
# 현재 도보 동선은 좌표 기반 추정치이며, 실제 경로 기능을 추가할 때 입력하세요.
KAKAO_REST_API_KEY=

# [선택·추후 연동용] 한국관광공사 TourAPI 서비스키입니다.
# 관광지·행사 등 TourAPI 데이터를 추가로 수집할 때 사용합니다.
TOUR_API_SERVICE_KEY=

# [선택·추후 연동용] 에어코리아 전국 대기질 API 서비스키입니다.
AIRKOREA_SERVICE_KEY=

# [선택·추후 연동용] 서울 지하철 실시간 도착정보 API 인증키입니다.
SEOUL_SUBWAY_API_KEY=

# [선택·추후 연동용] 서울 버스 실시간 도착정보 API 서비스키입니다.
SEOUL_BUS_SERVICE_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# RAGFlow 서버 연동
# 아래 4개 필수값(BASE_URL, API_KEY, DATASET_IDS, ALLOWED_SOURCE_HOSTS)은
# 모두 입력하거나 모두 비워야 합니다. 일부만 입력하면 misconfigured 상태가 됩니다.
# 모든 값은 서버 전용이며 브라우저에 노출하면 안 됩니다.
# ─────────────────────────────────────────────────────────────────────────────

# RAGFlow 서버 주소입니다. 서버 루트 또는 /api/v1로 끝나는 주소를 입력할 수 있습니다.
# 예: https://ragflow.example.com
RAGFLOW_BASE_URL=

# RAGFlow에서 발급한 서버 API 키입니다. Bearer 인증에 사용됩니다.
RAGFLOW_API_KEY=

# 검색에 사용할 RAGFlow Dataset ID입니다. 여러 개면 쉼표로 구분하세요.
# 예: seoul-places,seoul-festivals
RAGFLOW_DATASET_IDS=

# 장소 데이터의 원본 출처로 신뢰할 hostname 목록입니다. 여러 개면 쉼표로 구분합니다.
# 프로토콜과 경로는 입력하지 않습니다. 예: data.seoul.go.kr
RAGFLOW_ALLOWED_SOURCE_HOSTS=

# 추천에 사용할 데이터의 최대 경과 일수입니다. 이보다 오래된 출처는 제외합니다.
# 허용 범위: 1~3650일
RAGFLOW_MAX_SOURCE_AGE_DAYS=30

# 한 번의 RAGFlow 검색에서 요청할 최대 청크 수입니다. 허용 범위: 1~100
RAGFLOW_PAGE_SIZE=30

# 검색 결과가 통과해야 하는 최소 유사도입니다. 허용 범위: 0~1
RAGFLOW_SIMILARITY_THRESHOLD=0.2

# 하이브리드 검색에서 벡터 유사도가 차지하는 비중입니다. 허용 범위: 0~1
RAGFLOW_VECTOR_SIMILARITY_WEIGHT=0.3

# RAGFlow 벡터 검색의 KNN 후보 수입니다. 허용 범위: 1~10000
RAGFLOW_KNN_TOP_K=1024

# RAGFlow 요청 제한시간이며 단위는 밀리초(ms)입니다. 허용 범위: 1000~60000
RAGFLOW_REQUEST_TIMEOUT_MS=10000

# ─────────────────────────────────────────────────────────────────────────────
# Airbyte 서버 연동
# Airbyte에서 미리 생성한 Source, Destination, Connection의 ID를 사용합니다.
# 인증은 고정 Access Token 또는 Client ID/Secret 방식 중 하나를 선택하세요.
# ─────────────────────────────────────────────────────────────────────────────

# Airbyte Public API 기준 주소입니다.
# 비워두면 https://api.airbyte.com/v1을 기본값으로 사용합니다.
# Self-Managed Airbyte라면 해당 인스턴스의 API 주소를 입력하세요.
AIRBYTE_API_URL=

# 인증 방식 1: 이미 발급된 고정 Bearer Access Token입니다.
# 이 값이 있으면 아래 Client ID/Secret 방식보다 우선합니다.
AIRBYTE_ACCESS_TOKEN=

# 인증 방식 2: Airbyte 애플리케이션의 Client ID와 Client Secret입니다.
# 둘 중 하나만 입력하면 안 되며 반드시 함께 입력해야 합니다.
AIRBYTE_CLIENT_ID=
AIRBYTE_CLIENT_SECRET=

# Client Credentials 방식에서 토큰을 발급받을 URL입니다.
# 비워두면 ${AIRBYTE_API_URL}/applications/token을 사용합니다.
AIRBYTE_TOKEN_URL=

# 서울 공공데이터·축제·물가 등을 메인 DB에 적재하는 Airbyte Connection ID입니다.
# 여러 개면 쉼표로 구분합니다.
AIRBYTE_MAIN_DB_CONNECTION_IDS=

# 검증된 메인 DB 데이터를 RAGFlow 적재 파이프라인으로 보내는 Connection ID입니다.
# 여러 개면 쉼표로 구분하며 메인 DB Connection ID와 중복되면 안 됩니다.
AIRBYTE_RAGFLOW_CONNECTION_IDS=

# Airbyte API 요청 제한시간이며 단위는 밀리초(ms)입니다. 허용 범위: 1000~60000
AIRBYTE_REQUEST_TIMEOUT_MS=15000

# ─────────────────────────────────────────────────────────────────────────────
# ZERO TRIP 서버 보안 및 요청 제한
# ─────────────────────────────────────────────────────────────────────────────

# /api/admin/tools/* 관리자 API를 보호하는 Bearer 토큰입니다.
# Airbyte 동기화 실행·상태 조회를 사용하려면 24자 이상의 임의 비밀값을 입력하세요.
ZERO_TRIP_TOOLS_ADMIN_TOKEN=

# 공개 추천 API에서 IP별로 허용할 분당 최대 요청 수입니다.
# 여러 서버 인스턴스를 운영할 때는 API Gateway의 공용 제한도 함께 설정하세요.
ZERO_TRIP_PLAN_RATE_LIMIT_PER_MINUTE=20

# 한 API 서버 프로세스에서 동시에 처리할 최대 추천 요청 수입니다.
ZERO_TRIP_PLAN_MAX_CONCURRENCY=8

# localhost가 아닌 HTTP 도구 서버 연결을 허용하는 개발 전용 옵션입니다.
# 실제 운영에서는 HTTPS를 사용하고 반드시 false를 유지하세요.
ZERO_TRIP_ALLOW_INSECURE_TOOL_HTTP=false

# 보안 주의: 실제 비밀값에는 VITE_ 접두사를 붙이지 마세요.
# VITE_ 변수는 빌드 시 브라우저 코드에 포함됩니다.
